{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "shortcuts": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@blotch/angular-lynx-build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "scripts": [],
            "appName": "Postcards",
            "appId": "dev.angularlynx.examples.postcards",
            "shortcuts": [
              {
                "id": "refresh",
                "title": "Refresh postcards",
                "phrases": ["Refresh {appName}", "Reload {appName}"],
                "symbol": "arrow.clockwise"
              },
              {
                "id": "stamps",
                "title": "Show stamps",
                "phrases": [
                  "Show stamps in {appName}",
                  "Open my stamps in {appName}"
                ],
                "route": "/stamps",
                "symbol": "seal"
              }
            ]
          }
        },
        "serve": {
          "builder": "@blotch/angular-lynx-build:dev-server",
          "options": {
            "buildTarget": "shortcuts:build"
          }
        }
      }
    }
  }
}
