{
  "name": "angular-lynx-monorepo",
  "private": true,
  "description": "Monorepo for AngularLynx — Angular renderer for the Lynx cross-platform native UI framework",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git"
  },
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "main": "index.js",
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=!@blotch/angular-lynx-website",
    "build:examples": "turbo run build --filter='@angular-lynx-example/*^...' && NG_BUILD_MAX_WORKERS=2 turbo run build --filter='@angular-lynx-example/*' --only --concurrency=4 -- --base-href=/examples/",
    "build:all": "turbo run build --filter=./packages/*",
    "clean:caches": "node packages/release/src/prune-caches.ts",
    "test": "turbo run test",
    "test:no-cache": "turbo run test --force",
    "test:coverage": "turbo run test:coverage",
    "test:ci:coverage": "turbo run test:ci:coverage",
    "e2e": "turbo run build --filter=@blotch/angular-lynx-e2e^... && npm run e2e -w packages/e2e --",
    "set-version": "node packages/release/src/set-version.ts",
    "demo": "turbo run start --filter=@angular-lynx-example/kitchen-sink-app",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "cspell": "turbo run cspell",
    "publish:local": "turbo run publish:local",
    "dolan:update:force": "turbo run dolan:update:force"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cspell": "^10.4.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10",
    "vitest": "^5.0.5",
    "yalc": "^1.0.0-pre.53"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "@lynx-js/rspeedy": {
      "typescript": ">=6.0.0"
    }
  }
}
