{
  "name": "@blotch/angular-lynx-build",
  "version": "22.2.7",
  "description": "Angular CLI builders for AngularLynx: ng build, ng serve and ng test for Lynx, and native iOS and Android apps",
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git",
    "directory": "packages/build"
  },
  "files": [
    "dist",
    "builders/**/*.js",
    "builders/**/*.mjs",
    "builders/**/*.d.mts",
    "builders/**/*.json",
    "client.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./unit-test/lynx-globals": {
      "types": "./builders/unit-test/lynx-globals.d.mts",
      "default": "./builders/unit-test/lynx-globals.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.builders.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "publish:local": "yalc publish --push"
  },
  "dependencies": {
    "@blotch/angular-lynx-native": "22.2.7",
    "@blotch/rsbuild-plugin-angular-lynx": "22.2.7",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.3",
    "@lynx-js/rspeedy": "^0.18.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.2",
    "@angular/build": "^22.2.1",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.0"
  },
  "peerDependencies": {
    "@angular-devkit/architect": ">=0.2200.0 <0.2300.0",
    "@angular/build": "^22.2.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "builders": "./builders/builders.json",
  "ng-update": {
    "packageGroup": [
      "@blotch/angular-lynx",
      "@blotch/angular-lynx-build",
      "@blotch/angular-lynx-testing-library",
      "@blotch/rsbuild-plugin-angular-lynx",
      "@blotch/angular-lynx-native"
    ]
  }
}
