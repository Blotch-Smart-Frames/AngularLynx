{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Angular CLI loads builders with require(), so they compile to CommonJS
    // (builders/package.json marks the folder). Node16 keeps `import()` as a
    // real dynamic import in that output: the builders load rspeedy, the
    // rsbuild plugin and the native builder, which are all ESM-only, and
    // `module: commonjs` would turn those imports into require() calls.
    "module": "node16",
    "moduleResolution": "node16",
    "verbatimModuleSyntax": false,
    "lib": ["ES2022"],
    "outDir": "./builders",
    "rootDir": "./builders",
    "resolveJsonModule": true,
    "importHelpers": false,
    "types": ["node"]
  },
  "include": ["builders/**/*.ts"],
  "exclude": ["builders/**/*.test.ts", "node_modules"]
}
