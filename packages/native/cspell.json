  "// patterns": "OpenGL ES's identifiers in the shells' WebGL code: its functions (glGetProgramiv), constants (GL_RENDERBUFFER), types (GLsizei), Android's GLES30 class, EAGL's classes and constants, and the generated opcode names.",
  "patterns": [
    { "name": "gl-functions", "pattern": "/\\bgl[A-Z]\\w*/g" },
    { "name": "gl-constants", "pattern": "/\\b(?:GL|EGL)_\\w+/g" },
    { "name": "gl-types", "pattern": "/\\bGL(?:ES\\d*|[a-z]\\w*)/g" },
    { "name": "ios-gl-classes", "pattern": "/\\b(?:CA|k)?EAGL\\w*/g" },
    {
      "name": "webgl-ops",
      "pattern": "/\\b(?:ALWebGLOp|WebGLOps\\.|const val )\\w*/g"
    }
  ],
  "ignoreRegExpList": [
    "gl-functions",
    "gl-constants",
    "gl-types",
    "ios-gl-classes",
    "webgl-ops",
    "HexValues"
  ]
}
