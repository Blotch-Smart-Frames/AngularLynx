{
  "name": "@blotch/angular-lynx-native",
  "version": "22.2.1",
  "description": "Builds AngularLynx apps into iOS and Android binaries",
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git",
    "directory": "packages/native"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "generate:ios-project": "cd templates/ios && mkdir -p Frameworks && xcodegen generate --quiet && rmdir Frameworks",
    "build:lynx-ios-frameworks": "scripts/build-lynx-ios-frameworks.sh",
    "publish:local": "yalc publish --push"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
