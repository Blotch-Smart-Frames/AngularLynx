<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- fetch() and XMLHttpRequest go through Lynx's HTTP service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- angular-lynx:permissions -->

    <!--
      The apps LynxLinking.canOpenURL() can see from Android 11: those that
      open angular.json's canOpenURLSchemes (LinkingModule).
    -->
    <!-- angular-lynx:queries -->

    <!--
      Auto Backup leaves out LynxSecureStorage's file (SecureStorageModule):
      dataExtractionRules from Android 12, fullBackupContent before.
    -->
    <application
        android:name=".ShellApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AngularLynxShell"
        tools:targetApi="31">
        <!--
          One activity holding one LynxView; Angular Router does all navigation
          inside it. configChanges keeps the activity (and the running Angular
          app) alive on rotation, resizing and dark-mode switches instead of
          restarting it; the LynxView re-lays itself out.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="${screenOrientation}"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- angular-lynx:deep-links -->
        </activity>

        <!--
          The files LynxShare shares (ShareModule), which the app picked in
          the share sheet reads through content:// URIs of this provider.
          It's not exported: each share grants the one app it goes to.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.angularlynx.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!--
          Lets Google Play services install the Photo Picker that
          LynxImagePicker opens (ImagePickerModule) on Android 10 and older,
          which don't have one. Without it, they open the document picker.
        -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>
    </application>

</manifest>
