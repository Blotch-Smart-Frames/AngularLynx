<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No action bar: the Angular app draws the whole screen. The window
      background shows before the first Lynx frame, so it matches the default
      light/dark page background instead of flashing.
    -->
    <style name="Theme.AngularLynxShell" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
      The splash screen, from the tap on the icon until the app's first screen
      is ready (MainActivity keeps it up until the runtime says so). AndroidX's
      core-splashscreen draws it as Android 12 and later do on every version,
      and switches to the theme above once it's installed. Its color is the
      window's, and its image splash_icon: the launcher icon, or angular.json's
      splash.image, which the generator writes in its place.
    -->
    <style name="Theme.AngularLynxShell.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AngularLynxShell</item>
    </style>
</resources>
