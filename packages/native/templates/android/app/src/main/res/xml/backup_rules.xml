<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup up to Android 11 (data_extraction_rules.xml is Android 12's).
  Everything is backed up but LynxSecureStorage's values, those behind
  biometrics too: the Keystore keys that encrypt them never leave the device,
  so a restored copy couldn't be read (SecureStorageModule.kt and
  BiometricsModule.kt).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="angular_lynx_secure_storage.xml" />
    <exclude domain="sharedpref" path="angular_lynx_biometric_storage.xml" />
</full-backup-content>
