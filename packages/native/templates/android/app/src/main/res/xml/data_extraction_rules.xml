<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device transfer from Android 12 (backup_rules.xml is for older
  versions). Everything goes but LynxSecureStorage's values, those behind
  biometrics too: the Keystore keys that encrypt them never leave the device,
  so a copy elsewhere couldn't be read (SecureStorageModule.kt and
  BiometricsModule.kt).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="angular_lynx_secure_storage.xml" />
        <exclude domain="sharedpref" path="angular_lynx_biometric_storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="angular_lynx_secure_storage.xml" />
        <exclude domain="sharedpref" path="angular_lynx_biometric_storage.xml" />
    </device-transfer>
</data-extraction-rules>
