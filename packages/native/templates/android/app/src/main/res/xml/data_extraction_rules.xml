<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device transfer from Android 12 (backup_rules.xml is for older
  versions). Everything goes but LynxSecureStorage's values: the Keystore key
  that encrypts them never leaves the device, so a copy elsewhere couldn't be
  read (SecureStorageModule.kt).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="angular_lynx_secure_storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="angular_lynx_secure_storage.xml" />
    </device-transfer>
</data-extraction-rules>
