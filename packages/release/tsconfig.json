{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Node runs these scripts directly (type stripping), so imports name the
    // .ts file and the code avoids syntax that needs transforming.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "importHelpers": false
  },
  "include": ["src"]
}
