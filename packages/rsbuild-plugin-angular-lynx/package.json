{
  "name": "@blotch/rsbuild-plugin-angular-lynx",
  "version": "22.2.0",
  "description": "Rsbuild plugin for building AngularLynx applications",
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git",
    "directory": "packages/rsbuild-plugin-angular-lynx"
  },
  "files": [
    "dist",
    "patch"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "postinstall": "node ./patch/patch-angular-build.cjs",
    "publish:local": "yalc publish --push"
  },
  "dependencies": {
    "@lynx-js/css-extract-webpack-plugin": "^0.11.0",
    "@lynx-js/rsbuild-plugin": "^0.1.3",
    "@lynx-js/runtime-wrapper-webpack-plugin": "^0.2.4",
    "@lynx-js/template-webpack-plugin": "^0.16.2",
    "@lynx-js/webpack-runtime-globals": "^0.0.8",
    "rsbuild-plugin-tailwindcss": "0.2.4",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular-devkit/core": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@rsbuild/core": "^2.2.9",
    "@rslib/core": "^0.21.4",
    "@rspack/core": "^2.2.8",
    "@types/node": "^25.6.2",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "@lynx-js/rspeedy": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "@angular/localize": {
      "optional": true
    }
  }
}
