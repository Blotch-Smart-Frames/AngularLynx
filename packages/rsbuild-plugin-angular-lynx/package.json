{
  "name": "@blotch/rsbuild-plugin-angular-lynx",
  "version": "22.0.0",
  "description": "Rsbuild plugin for building AngularLynx applications",
  "files": [
    "dist",
    "patch"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "postinstall": "node ./patch/patch-angular-build.cjs",
    "publish:local": "yalc publish --push"
  },
  "dependencies": {
    "@lynx-js/css-extract-webpack-plugin": "^0.7.1",
    "@lynx-js/runtime-wrapper-webpack-plugin": "^0.1.3",
    "@lynx-js/template-webpack-plugin": "^0.11.0",
    "@lynx-js/webpack-runtime-globals": "^0.0.6",
    "rsbuild-plugin-tailwindcss": "0.2.4",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@rsbuild/core": "^2.0.5",
    "@rslib/core": "^0.21.4",
    "@rspack/core": "^2.0.2",
    "@types/node": "^25.6.2",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/localize": "^22.0.0",
    "@lynx-js/rspeedy": "^0.14.3"
  },
  "peerDependenciesMeta": {
    "@angular/localize": {
      "optional": true
    }
  }
}
