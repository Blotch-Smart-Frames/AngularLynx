{
  "name": "@blotch/rsbuild-plugin-angular-lynx",
  "version": "22.2.16",
  "description": "Rsbuild plugin for building AngularLynx applications",
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git",
    "directory": "packages/rsbuild-plugin-angular-lynx"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "publish:local": "yalc publish --push"
  },
  "dependencies": {
    "@lynx-js/css-extract-webpack-plugin": "^0.11.1",
    "@lynx-js/rsbuild-plugin": "^0.1.3",
    "@lynx-js/runtime-wrapper-webpack-plugin": "^0.2.4",
    "@lynx-js/template-webpack-plugin": "^0.16.2",
    "@lynx-js/webpack-runtime-globals": "^0.0.9",
    "postcss-selector-parser": "^7.1.7",
    "postcss-value-parser": "^4.2.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.2",
    "@angular/build": "^22.2.5",
    "@formatjs/intl-datetimeformat": "^8.0.2",
    "@formatjs/intl-displaynames": "^8.0.1",
    "@formatjs/intl-getcanonicallocales": "^3.3.0",
    "@formatjs/intl-listformat": "^9.0.1",
    "@formatjs/intl-locale": "^5.4.2",
    "@formatjs/intl-numberformat": "^10.0.2",
    "@formatjs/intl-pluralrules": "^7.0.2",
    "@formatjs/intl-relativetimeformat": "^13.0.1",
    "@rsbuild/core": "~2.2.9",
    "@rslib/core": "^1.0.5",
    "@rspack/core": "~2.2.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.6.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@angular-devkit/core": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "@formatjs/intl-datetimeformat": "^8.0.2",
    "@formatjs/intl-displaynames": "^8.0.1",
    "@formatjs/intl-getcanonicallocales": "^3.3.0",
    "@formatjs/intl-listformat": "^9.0.1",
    "@formatjs/intl-locale": "^5.4.2",
    "@formatjs/intl-numberformat": "^10.0.2",
    "@formatjs/intl-pluralrules": "^7.0.2",
    "@formatjs/intl-relativetimeformat": "^13.0.1",
    "@lynx-js/rspeedy": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "@angular/localize": {
      "optional": true
    },
    "@formatjs/intl-datetimeformat": {
      "optional": true
    },
    "@formatjs/intl-displaynames": {
      "optional": true
    },
    "@formatjs/intl-getcanonicallocales": {
      "optional": true
    },
    "@formatjs/intl-listformat": {
      "optional": true
    },
    "@formatjs/intl-locale": {
      "optional": true
    },
    "@formatjs/intl-numberformat": {
      "optional": true
    },
    "@formatjs/intl-pluralrules": {
      "optional": true
    },
    "@formatjs/intl-relativetimeformat": {
      "optional": true
    }
  },
  "ng-update": {
    "packageGroup": [
      "@blotch/angular-lynx",
      "@blotch/angular-lynx-build",
      "@blotch/angular-lynx-testing-library",
      "@blotch/rsbuild-plugin-angular-lynx",
      "@blotch/angular-lynx-native"
    ]
  }
}
