{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2021"],
    "module": "ESNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node"]
  },
  "angularCompilerOptions": {},
  "include": ["src"]
}
