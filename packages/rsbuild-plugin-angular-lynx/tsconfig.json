{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2021"],
    "module": "ESNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node"],
    // Types for the `@angular/build` internals loaded by
    // src/utils/angular/build-internals.ts. Its `exports` map doesn't list
    // these paths, so resolve them straight from the hoisted package files,
    // mirroring how the runtime loads them by absolute path.
    "paths": {
      "@angular/build/src/*": ["../../node_modules/@angular/build/src/*"]
    }
  },
  "angularCompilerOptions": {},
  "include": ["src"]
}
