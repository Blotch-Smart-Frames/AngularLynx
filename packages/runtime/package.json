{
  "name": "@blotch/angular-lynx",
  "version": "22.3.1",
  "description": "Angular renderer for the Lynx cross-platform native UI framework",
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git",
    "directory": "packages/runtime"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/blotch-angular-lynx.d.ts",
      "default": "./dist/fesm2022/blotch-angular-lynx.mjs"
    },
    "./tailwind.css": {
      "style": "./tailwind.css",
      "default": "./tailwind.css"
    }
  },
  "scripts": {
    "build:schematics": "tsc -p tsconfig.schematics.json",
    "build": "npm run build:schematics && ng-packagr -p ng-package.json -c tsconfig.lib.prod.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "publish:local": "cd dist && yalc publish --push"
  },
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.3.0",
    "@angular-devkit/schematics": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@schematics/angular": "^22.3.0",
    "@types/node": "^22.0.0",
    "jsdom": "^31.0.0",
    "ng-packagr": "^22.3.0",
    "typescript": "~6.0.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    },
    "@angular/localize": {
      "optional": true
    }
  },
  "ng-update": {
    "migrations": "./schematics/migrations.json",
    "packageGroup": [
      "@blotch/angular-lynx",
      "@blotch/angular-lynx-build",
      "@blotch/angular-lynx-testing-library",
      "@blotch/rsbuild-plugin-angular-lynx",
      "@blotch/angular-lynx-native"
    ]
  },
  "schematics": "./schematics/collection.json"
}
