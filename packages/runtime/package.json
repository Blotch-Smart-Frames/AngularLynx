{
  "name": "@blotch/angular-lynx",
  "version": "22.2.0",
  "description": "Angular renderer for the Lynx cross-platform native UI framework",
  "homepage": "https://github.com/Blotch-Smart-Frames/AngularLynx#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/AngularLynx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/AngularLynx.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist",
    "schematics",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/blotch-angular-lynx.d.ts",
      "default": "./dist/fesm2022/blotch-angular-lynx.mjs"
    }
  },
  "scripts": {
    "build:schematics": "tsc -p tsconfig.schematics.json",
    "build": "npm run build:schematics && ng-packagr -p ng-package.json -c tsconfig.lib.prod.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell .",
    "publish:local": "yalc publish --push"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.2",
    "@angular-devkit/schematics": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@schematics/angular": "^22.2.2",
    "@types/node": "^22.0.0",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    },
    "@angular/localize": {
      "optional": true
    }
  },
  "schematics": "./schematics/collection.json"
}
