{
  "name": "@blotch/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Source components for @blotch/cli — not published to npm",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./components/*": "./src/lib/components/*/index.ts",
    "./theme/tailwind-plugin": "./src/lib/theme/tailwind-plugin.ts",
    "./theme/*": "./src/lib/theme/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@blotch/angular-lynx": "*",
    "@blotch/angular-lynx-testing-library": "*",
    "@lynx-js/tailwind-preset": "^0.4.0",
    "tailwindcss": "^3.4.19"
  }
}
