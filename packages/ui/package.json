{
  "name": "@blotch/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Source components for @blotch/cli — not published to npm",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./components/*": "./src/lib/components/*/index.ts",
    "./theme/tailwind-plugin": "./src/lib/theme/tailwind-plugin.ts",
    "./theme/*": "./src/lib/theme/*"
  },
  "scripts": {
    "test": "ng test --no-watch",
    "test:coverage": "node scripts/test-coverage.ts",
    "test:ci:coverage": "node scripts/test-coverage.ts",
    "test:ui": "ng test --ui --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell ."
  },
  "dependencies": {
    "@tanstack/charts": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@blotch/angular-lynx": "*",
    "@blotch/angular-lynx-build": "*",
    "@blotch/angular-lynx-testing-library": "*",
    "@lynx-js/tailwind-preset": "^0.6.0",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.10"
  }
}
