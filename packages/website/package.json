{
  "name": "@blotch/angular-lynx-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean-example-caches": "find ../../examples -maxdepth 3 -path '*/node_modules/.cache' -type d -exec rm -rf {} + 2>/dev/null; exit 0",
    "build-examples": "npm run clean-example-caches && NG_BUILD_MAX_WORKERS=2 turbo run build --filter='@angular-lynx-example/*' --concurrency=4",
    "prepare-examples": "node scripts/prepare-examples.mjs",
    "dev:no-cache": "npm run build-examples && npm run prepare-examples && rspress dev",
    "dev": "rspress dev",
    "build": "npm run build-examples && npm run prepare-examples && rspress build",
    "build:ci": "npm run prepare-examples && rspress build",
    "preview": "rspress preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cspell": "cspell ."
  },
  "dependencies": {
    "@lynx-js/css-serializer": "^0.1.6",
    "@lynx-js/go-web": "^0.5.0",
    "@lynx-js/lynx-core": "^0.1.3",
    "@lynx-js/web-core": "^0.20.3",
    "@lynx-js/web-elements": "^0.12.0",
    "@rspress/core": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rspress-plugin-mermaid": "^1.0.1"
  },
  "devDependencies": {
    "@rsbuild/plugin-sass": "^1.5.1",
    "@shikijs/transformers": "^3.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sass": "^1.80.0",
    "typescript": "~5.6.3"
  }
}
